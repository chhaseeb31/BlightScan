rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    match /users/{userId} {
      allow read, create, update: if owner(userId);
      match /scans/{scanId} {
        allow read, write: if owner(userId);
      }
    }
    match /posts/{postId} {

      // Authenticated users can read posts.
      allow read: if request.auth != null;

      // User can create only their own post.
      allow create:
        if request.auth != null
           && request.resource.data.authorId == request.auth.uid;

      // Only original author can update.
      // authorId cannot be changed.
      allow update:
        if request.auth != null
           && resource.data.authorId == request.auth.uid
           && request.resource.data.authorId == resource.data.authorId;

      // Only original author can delete.
      allow delete:
        if request.auth != null
           && resource.data.authorId == request.auth.uid;


      // ==========================================================
      // COMMENTS
      // /posts/{postId}/comments/{commentId}
      // ==========================================================
      match /comments/{commentId} {

        // Authenticated users can read comments.
        allow read: if request.auth != null;

        // Comment must belong to authenticated user
        // when authorId is present.
        allow create:
          if request.auth != null
             && request.resource.data.authorId == request.auth.uid;

        // Only comment author can update.
        allow update:
          if request.auth != null
             && resource.data.authorId == request.auth.uid
             && request.resource.data.authorId == resource.data.authorId;

        // Only comment author can delete.
        allow delete:
          if request.auth != null
             && resource.data.authorId == request.auth.uid;
      }
    }
    match /community_posts/{postId} {
      allow read: if signedIn();
      allow create: if owner(request.resource.data.authorId)
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 5000
        && request.resource.data.likedBy == []
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount'])
        && request.resource.data.likedBy is list
        && request.resource.data.likedBy.size() == request.resource.data.likedBy.toSet().size()
        && request.resource.data.likeCount == request.resource.data.likedBy.size()
        && request.resource.data.likedBy.toSet().difference(resource.data.likedBy.toSet()).hasOnly([request.auth.uid])
        && resource.data.likedBy.toSet().difference(request.resource.data.likedBy.toSet()).hasOnly([request.auth.uid]);
      allow delete: if owner(resource.data.authorId);
      match /comments/{commentId} {
        allow read: if signedIn() && exists(/databases/$(database)/documents/community_posts/$(postId));
        allow create: if owner(request.resource.data.authorId)
          && exists(/databases/$(database)/documents/community_posts/$(postId))
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow delete: if owner(resource.data.authorId);
      }
    }
  }
}
